# Connexion PostgreSQL — remplace par tes identifiants
# En local : postgresql://user:password@localhost:5432/locabenin
# Hébergé (Neon, Supabase, Railway...) : copie l'URL fournie par le service
DATABASE_URL="postgresql://user:password@localhost:5432/locabenin"

# NextAuth — génère un secret aléatoire avec : openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# MTN MoMo Collections API (sandbox) — https://momodeveloper.mtn.com
# 1. Crée un compte développeur MTN, abonne-toi au produit "Collections"
# 2. Récupère ta Primary/Subscription Key
# 3. Crée un "API User" + "API Key" sandbox via leur endpoint de provisioning
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENV="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
# URL publique (ex: ngrok en dev, ton domaine en prod) que MTN appellera
# pour notifier le résultat du paiement
MTN_MOMO_CALLBACK_URL="https://ton-domaine.com/api/webhooks/momo"

# Secret que TOI seul connais, ajouté automatiquement à la fin de l'URL
# ci-dessus (?token=...) pour que le webhook rejette toute requête qui ne
# le connaît pas. Génère-le avec : openssl rand -hex 24
MTN_MOMO_WEBHOOK_SECRET=""

MOOV_MONEY_API_KEY=""

# SMS — Africa's Talking (https://africastalking.com), couvre le Bénin
AFRICASTALKING_USERNAME=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_SENDER_ID=""

# WhatsApp — Meta Cloud API (nécessite un compte Meta Business vérifié
# et un modèle de message pré-approuvé nommé WHATSAPP_TEMPLATE_NAME)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="rappel_loyer"

# Secret pour protéger /api/cron/check-retards (même principe que le
# webhook MoMo). Génère-le avec : openssl rand -hex 24
CRON_SECRET=""
